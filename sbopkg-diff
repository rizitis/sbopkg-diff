#!/bin/bash

# --- Check dependencies ---
command -v jq   &>/dev/null || { echo "ERROR: jq not found."   >&2; exit 1; }
command -v curl &>/dev/null || { echo "ERROR: curl not found." >&2; exit 1; }

# --- Validate input ---
PKG="${1:?Usage: $0 <package-name>}"
PKG="${PKG//[^a-zA-Z0-9._-]/}" # Sanitize: allow only safe characters
if [[ -z "$PKG" ]]; then
  echo "ERROR: Invalid package name." >&2
  exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo "You are root. READING /root/.sbopkg.conf first (if exists) "
else
    echo "You are NOT root. READING only /etc/sbopkg/sbopkg.conf "
fi


# --- Parse config safely without sourcing ---
parse_conf() {
  local file="$1"
  local key="$2"
  grep -m1 "^${key}=" "$file" 2>/dev/null \
    | cut -d= -f2- \
    | tr -d '"' | tr -d "'" | tr -d '[:space:]'
}

# --- Locate config file ---
if [[ -f /root/.sbopkg.conf ]]; then
  CONF=/root/.sbopkg.conf
elif [[ -f /etc/sbopkg/sbopkg.conf ]]; then
  CONF=/etc/sbopkg/sbopkg.conf
else
  echo "ERROR: No sbopkg.conf found." >&2
  exit 1
fi

# Security check: ensure config is not a symlink
if [[ -L "$CONF" ]]; then
  echo "ERROR: Config '$CONF' is a symlink — refusing to read." >&2
  exit 1
fi

REPO_NAME=$(parse_conf "$CONF" "REPO_NAME")
REPO_BRANCH=$(parse_conf "$CONF" "REPO_BRANCH")

# Clean bash default-value syntax (e.g., ${REPO_NAME:-SBo})
REPO_NAME="${REPO_NAME#*:-}"; REPO_NAME="${REPO_NAME%\}}"
REPO_BRANCH="${REPO_BRANCH#*:-}"; REPO_BRANCH="${REPO_BRANCH%\}}"

# --- Determine API endpoint and LOCAL_TREE path ---
case "$REPO_NAME" in
  SBo-git)
    LOCAL_TREE="/var/lib/sbopkg/SBo-git"
    API="https://api.github.com/repos/Ponce/slackbuilds"
    ;;
  SBo|*)
    LOCAL_TREE="/var/lib/sbopkg/${REPO_NAME}/${REPO_BRANCH}"
    API="https://api.github.com/repos/SlackBuildsOrg/slackbuilds"
    ;;
esac

# --- Find package category locally ---
# We use the local tree to identify the category (e.g., desktop, system)
INFO_LOCAL=$(find "$LOCAL_TREE" -name "${PKG}.info" ! -type l 2>/dev/null | head -1)
if [[ -z "$INFO_LOCAL" ]]; then
  echo "ERROR: '$PKG' not found in local tree. Sync first or check name." >&2
  exit 1
fi
CAT=$(echo "$INFO_LOCAL" | awk -F/ '{print $(NF-2)}')

echo ">>> Config: REPO=$REPO_NAME BRANCH=$REPO_BRANCH"
echo ">>> Found locally: $CAT/$PKG"
echo ""

# --- Safe curl wrapper with security defaults ---
safe_curl() {
  curl --silent --show-error --fail --max-time 20 \
    --proto '=https' --tlsv1.2 "$@"
}

# --- 1. Version Check (Live from API Content) ---
echo "=== Version check (Live from GitHub) ==="

# Fetch the .info file directly from the branch (raw) to bypass API commit cache
REMOTE_INFO_URL="${API}/contents/$CAT/$PKG/${PKG}.info?ref=$REPO_BRANCH"
REMOTE_CONTENT=$(safe_curl -H "Accept: application/vnd.github.v3.raw" "$REMOTE_INFO_URL")

if [[ $? -ne 0 || -z "$REMOTE_CONTENT" ]]; then
    echo "ERROR: Could not fetch remote info."
    SBO_VER="Unknown"
else
    SBO_VER=$(echo "$REMOTE_CONTENT" | grep "^VERSION=" | cut -d'"' -f2)
fi

# Determine installed version from pkgtools
INSTALLED=$(find /var/lib/pkgtools/packages -maxdepth 1 ! -type l -name "${PKG}-*" 2>/dev/null | head -1)
if [[ -n "$INSTALLED" ]]; then
    # Slackware versioning: extract version by stripping build, arch, and tag
    INST_VER=$(basename "$INSTALLED" | rev | cut -d- -f3- | rev | sed "s/^${PKG}-//")
else
    INST_VER="Not Installed"
fi

echo "Installed : $INST_VER"
echo "SBo latest: $SBO_VER"

if [[ "$INST_VER" != "Not Installed" && "$SBO_VER" != "Unknown" ]]; then
    if [[ "$INST_VER" == "$SBO_VER" ]]; then
        echo ">>> UP TO DATE"
    else
        # Version comparison using sort -V
        NEWER=$(printf '%s\n%s' "$INST_VER" "$SBO_VER" | sort -V | tail -n1)
        if [[ "$NEWER" == "$SBO_VER" ]]; then
            echo ">>> UPDATE AVAILABLE"
        else
            echo ">>> YOUR VERSION IS NEWER"
        fi
    fi
fi
echo ""

# --- 2. Fetch Recent Commits ---
echo "=== Recent commits ($REPO_BRANCH) ==="
# Fetch last 5 commits for the specific package path
COMMITS=$(safe_curl "$API/commits?path=$CAT/$PKG&sha=$REPO_BRANCH&per_page=5")
if [[ -n "$COMMITS" ]]; then
    # Format: Date | Short SHA | First line of commit message
    echo "$COMMITS" | jq -r '.[] | "\(.commit.committer.date)  \(.sha[0:7])  \(.commit.message | split("\n")[0])"' | cat -v | head -3
fi
echo ""

# --- 3. Fetch Latest Diff ---
echo "=== Latest diff for $PKG ==="
# Get the SHA of the most recent commit affecting this path
SHA=$(echo "$COMMITS" | jq -r '.[0].sha')

if [[ -n "$SHA" && "$SHA" != "null" ]]; then
    # Fetch the diff in raw format and isolate the specific package changes using sed
    safe_curl -H "Accept: application/vnd.github.v3.diff" "$API/commits/$SHA" \
        | sed -n "/diff --git a\/$CAT\/$PKG/,/diff --git/p" \
        | grep -v "^diff --git" | cat -v
else
    echo ">>> No commits found for $CAT/$PKG in branch $REPO_BRANCH"
fi
